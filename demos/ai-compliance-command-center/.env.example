# Optional — the demo runs fully in-memory without these.
# Set them to persist alerts/cases/audit to a Supabase project (see supabase/schema.sql).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional — set to enable AI-generated SAR narratives via Claude (claude-sonnet-4-6).
# Without this key the app falls back to the built-in deterministic stub.
# VITE_ANTHROPIC_API_KEY=sk-ant-...

# Optional — to wire the risk engine / SAR drafter to a real Azure OpenAI
# deployment instead of the built-in deterministic stubs (not required for the demo).
# VITE_AZURE_OPENAI_ENDPOINT=
# VITE_AZURE_OPENAI_DEPLOYMENT=gpt-4o
